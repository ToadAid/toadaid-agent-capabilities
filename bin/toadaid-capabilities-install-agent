#!/usr/bin/env bash

# ToadAid Agent Capabilities — generic-agent bootstrap
#
# This installer prepares an exact local package artifact plus a host-owned
# integration manifest. It DOES NOT wire a host, grant capability authority,
# modify host policy, enable ALLOW, publish to npm, or install into a host repo.
#
# Shell law:
# - no set -e
# - no set -u
# - no pipefail
# - no explicit shell exit

set +e
set +u
set +o pipefail 2>/dev/null
umask 077

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"

PROFILE="safe-observe"
STATE_ROOT="${XDG_STATE_HOME:-${HOME:-}/.local/state}/toadaid-agent-capabilities"
ARTIFACT_ROOT=""
MANIFEST_PATH=""
CHECK_ONLY=false

usage() {
  cat <<'TXT'
Usage: bin/toadaid-capabilities-install-agent [options]

Prepare a checked-out ToadAid Agent Capabilities repository for integration
into a generic Node.js agent.

Options:
  --profile NAME       requested capability profile (default: safe-observe)
  --state-root PATH    host-owned integration state root
  --artifact-root PATH generated local package artifact directory
  --manifest PATH      integration manifest path
  --check-only         verify prerequisites and report without writing
  -h, --help           show this help

Security boundary:
  Installation makes capability code available; it grants NO authority.
  The generated profile request starts OFF with zero capability grants.
  Host policy, provider bindings, approvals, secrets, and ALLOW transitions
  remain host-owned and must be wired separately.
TXT
}

fail() {
  printf 'toadaid-capabilities-install-agent: %s\n' "$1" >&2
  return 2
}

abs_path() {
  node -e 'const path=require("node:path"); console.log(path.resolve(process.argv[1]))' "$1"
}

sha256_file() {
  node -e '
    const fs=require("node:fs");
    const crypto=require("node:crypto");
    const p=process.argv[1];
    const h=crypto.createHash("sha256");
    h.update(fs.readFileSync(p));
    console.log(h.digest("hex"));
  ' "$1"
}

write_exact() {
  target="$1"
  mode="$2"
  source="$3"

  if [[ -L "$target" ]]; then
    fail "refusing symlink target: $target"
    return 2
  fi

  if [[ -e "$target" ]]; then
    if [[ ! -f "$target" ]]; then
      fail "refusing non-regular existing target: $target"
      return 2
    fi
    if ! cmp -s "$source" "$target"; then
      fail "refusing to overwrite different existing file: $target"
      return 2
    fi
    chmod "$mode" "$target" 2>/dev/null
    chmod_rc=$?
    rm -f "$source"
    if [[ $chmod_rc -ne 0 ]]; then
      fail "cannot set mode on existing target: $target"
      return 2
    fi
    return 0
  fi

  mv "$source" "$target" 2>/dev/null
  mv_rc=$?
  if [[ $mv_rc -ne 0 ]]; then
    fail "cannot install target: $target"
    return 2
  fi

  chmod "$mode" "$target" 2>/dev/null
  chmod_rc=$?
  if [[ $chmod_rc -ne 0 ]]; then
    fail "cannot set mode on target: $target"
    return 2
  fi
  return 0
}

validate_profile() {
  node - "$1" <<'NODE'
const fs = require('node:fs')

const path = process.argv[2]
const profile = JSON.parse(fs.readFileSync(path, 'utf8'))
const expected = [
  'browser:evidence',
  'workspace:snapshot',
  'workspace:diff',
  'host:process-read',
]

const ids = profile.requestedCapabilities?.map((entry) => entry.capabilityId) ?? []
const ok =
  profile.schemaVersion === 'toadaid.agent-capability-profile.v1' &&
  profile.profileId === 'safe-observe' &&
  profile.activationDefault === 'OFF' &&
  profile.installationGrantsAuthority === false &&
  Array.isArray(profile.capabilityGrants) &&
  profile.capabilityGrants.length === 0 &&
  JSON.stringify(ids) === JSON.stringify(expected)

if (!ok) process.exitCode = 2
NODE
}

main() {
  if [[ -z "${HOME:-}" ]]; then
    fail "HOME must be set"
    return 2
  fi

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --profile)
        [[ "$#" -ge 2 ]] || { fail "--profile requires a value"; return 2; }
        PROFILE="$2"
        shift 2
        ;;
      --state-root)
        [[ "$#" -ge 2 ]] || { fail "--state-root requires a value"; return 2; }
        STATE_ROOT="$2"
        shift 2
        ;;
      --artifact-root)
        [[ "$#" -ge 2 ]] || { fail "--artifact-root requires a value"; return 2; }
        ARTIFACT_ROOT="$2"
        shift 2
        ;;
      --manifest)
        [[ "$#" -ge 2 ]] || { fail "--manifest requires a value"; return 2; }
        MANIFEST_PATH="$2"
        shift 2
        ;;
      --check-only)
        CHECK_ONLY=true
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        fail "unknown argument: $1"
        return 2
        ;;
    esac
  done

  if [[ "$PROFILE" != "safe-observe" ]]; then
    fail "unsupported profile in Generic Install P1: $PROFILE"
    return 2
  fi

  for command_name in git node npm; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      fail "required command unavailable: $command_name"
      return 2
    fi
  done

  node -e 'const [major]=process.versions.node.split(".").map(Number); if (major < 22) process.exitCode=2'
  node_rc=$?
  if [[ $node_rc -ne 0 ]]; then
    fail "Node.js 22 or newer is required"
    return 2
  fi

  if [[ ! -x "$REPO_ROOT/node_modules/.bin/tsc" ]]; then
    fail "checkout build dependencies are missing; run npm ci --include=dev in the checkout first"
    return 2
  fi

  package_json="$REPO_ROOT/package.json"
  profile_path="$REPO_ROOT/profiles/safe-observe.json"

  if [[ ! -f "$package_json" || ! -f "$profile_path" ]]; then
    fail "package.json or safe-observe profile is missing"
    return 2
  fi

  package_summary="$(
    node - "$package_json" <<'NODE'
const fs = require('node:fs')
const pkg = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'))
const ok =
  pkg.name === '@toadaid/agent-capabilities' &&
  pkg.private === true &&
  typeof pkg.version === 'string' &&
  pkg.engines?.node === '>=22'
if (!ok) process.exitCode = 2
console.log(`${pkg.name}\t${pkg.version}\t${pkg.private}`)
NODE
  )"
  package_rc=$?
  if [[ $package_rc -ne 0 ]]; then
    fail "package identity/private-runtime contract is invalid"
    return 2
  fi

  validate_profile "$profile_path"
  profile_rc=$?
  if [[ $profile_rc -ne 0 ]]; then
    fail "safe-observe profile contract is invalid"
    return 2
  fi

  package_name="$(printf '%s' "$package_summary" | cut -f1)"
  package_version="$(printf '%s' "$package_summary" | cut -f2)"
  package_private="$(printf '%s' "$package_summary" | cut -f3)"

  head="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null)"
  head_rc=$?
  tree="$(git -C "$REPO_ROOT" rev-parse HEAD^{tree} 2>/dev/null)"
  branch="$(git -C "$REPO_ROOT" branch --show-current 2>/dev/null)"
  status="$(git -C "$REPO_ROOT" status --porcelain=v1 --untracked-files=all 2>/dev/null)"
  clean=false
  [[ -z "$status" ]] && clean=true

  STATE_ROOT="$(abs_path "$STATE_ROOT")" || return 2
  if [[ -z "$ARTIFACT_ROOT" ]]; then
    ARTIFACT_ROOT="$STATE_ROOT/artifacts"
  fi
  ARTIFACT_ROOT="$(abs_path "$ARTIFACT_ROOT")" || return 2

  if [[ -z "$MANIFEST_PATH" ]]; then
    MANIFEST_PATH="$STATE_ROOT/agent-integration.json"
  fi
  MANIFEST_PATH="$(abs_path "$MANIFEST_PATH")" || return 2

  profile_sha256="$(sha256_file "$profile_path")"
  profile_sha_rc=$?

  if [[ $head_rc -ne 0 || $profile_sha_rc -ne 0 ]]; then
    fail "cannot resolve exact checkout/profile identity"
    return 2
  fi

  if [[ "$CHECK_ONLY" == true ]]; then
    node - \
      "$REPO_ROOT" "$branch" "$head" "$tree" "$clean" \
      "$package_name" "$package_version" "$package_private" \
      "$PROFILE" "$profile_sha256" "$STATE_ROOT" "$ARTIFACT_ROOT" "$MANIFEST_PATH" <<'NODE'
const [
  checkoutRoot, branch, head, tree, clean,
  packageName, packageVersion, packagePrivate,
  profile, profileSha256, stateRoot, artifactRoot, manifestPath,
] = process.argv.slice(2)

console.log(JSON.stringify({
  schemaVersion: 'toadaid.agent-capabilities-install-check.v1',
  status: 'CHECK_OK',
  distribution: 'CHECKOUT_LOCAL_TO_LOCAL_TARBALL',
  checkoutRoot,
  branch,
  head,
  tree,
  checkoutClean: clean === 'true',
  packageName,
  packageVersion,
  packagePrivate: packagePrivate === 'true',
  profile,
  profileSha256,
  stateRoot,
  artifactRoot,
  manifestPath,
  installationGrantsAuthority: false,
  activationDefault: 'OFF',
  capabilityGrants: [],
  npmPublicationPerformed: false,
  hostMutationPerformed: false,
}, null, 2))
NODE
    return 0
  fi

  if [[ "$clean" != true ]]; then
    fail "refusing artifact installation from a dirty checkout; commit/review or use --check-only"
    return 2
  fi

  mkdir -p "$STATE_ROOT" "$ARTIFACT_ROOT" "$(dirname -- "$MANIFEST_PATH")" 2>/dev/null
  mkdir_rc=$?
  if [[ $mkdir_rc -ne 0 ]]; then
    fail "cannot create host-owned state/artifact directories"
    return 2
  fi

  for real_dir in "$STATE_ROOT" "$ARTIFACT_ROOT" "$(dirname -- "$MANIFEST_PATH")"; do
    if [[ -L "$real_dir" || ! -d "$real_dir" ]]; then
      fail "installation directory must be a real directory: $real_dir"
      return 2
    fi
  done

  tmp_root="$(mktemp -d "${TMPDIR:-/tmp}/toadaid-capabilities-install.XXXXXX")"
  tmp_rc=$?
  if [[ $tmp_rc -ne 0 || ! -d "$tmp_root" ]]; then
    fail "cannot create temporary staging root"
    return 2
  fi

  stage="$tmp_root/package"
  pack_out="$tmp_root/pack"
  mkdir -p "$stage/dist" "$pack_out"
  stage_rc=$?
  if [[ $stage_rc -ne 0 ]]; then
    rm -rf "$tmp_root"
    fail "cannot create package staging directories"
    return 2
  fi

  # The staged package.json carries NO lifecycle scripts: some npm versions
  # (npm 10) still run `prepare` for `npm pack <dir>` despite --ignore-scripts.
  # --ignore-scripts below is kept as defense in depth only. The repository
  # package.json is never modified.
  node - "$REPO_ROOT/package.json" "$stage/package.json" <<'NODE'
const fs = require('node:fs')
const [source, target] = process.argv.slice(2)
const pkg = JSON.parse(fs.readFileSync(source, 'utf8'))
delete pkg.scripts
fs.writeFileSync(target, `${JSON.stringify(pkg, null, 2)}\n`, { flag: 'wx' })
const staged = JSON.parse(fs.readFileSync(target, 'utf8'))
if (Object.hasOwn(staged, 'scripts')) process.exitCode = 2
NODE
  stage_pkg_rc=$?
  cp "$REPO_ROOT/README.md" "$stage/README.md"
  readme_rc=$?
  cp "$REPO_ROOT/LICENSE" "$stage/LICENSE"
  license_rc=$?
  if [[ $stage_pkg_rc -ne 0 || $readme_rc -ne 0 || $license_rc -ne 0 ]]; then
    rm -rf "$tmp_root"
    fail "cannot stage package metadata"
    return 2
  fi

  (
    cd "$REPO_ROOT" || return 2
    "$REPO_ROOT/node_modules/.bin/tsc" \
      -p tsconfig.build.json \
      --outDir "$stage/dist"
  )
  build_rc=$?
  if [[ $build_rc -ne 0 ]]; then
    rm -rf "$tmp_root"
    fail "out-of-tree TypeScript build failed"
    return 2
  fi

  node - "$stage" <<'NODE'
const fs = require('node:fs')
const path = require('node:path')

const root = process.argv[2]
const pkg = JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8'))
const missing = []
for (const entry of Object.values(pkg.exports ?? {})) {
  for (const key of ['types', 'import']) {
    const rel = entry?.[key]
    if (typeof rel === 'string' && !fs.existsSync(path.join(root, rel))) {
      missing.push(rel)
    }
  }
}
if (missing.length) {
  console.error(`missing export targets: ${missing.join(', ')}`)
  process.exitCode = 2
}
NODE
  export_rc=$?
  if [[ $export_rc -ne 0 ]]; then
    rm -rf "$tmp_root"
    fail "staged package export verification failed"
    return 2
  fi

  packed_name="$(
    npm pack "$stage" \
      --ignore-scripts \
      --pack-destination "$pack_out" \
      --json 2>/dev/null \
      | node -e '
          let s="";
          process.stdin.on("data",d=>s+=d);
          process.stdin.on("end",()=>{
            try {
              const parsed=JSON.parse(s);
              process.stdout.write(parsed[0]?.filename ?? "");
            } catch {
              process.exitCode=2;
            }
          });
        '
  )"
  pack_rc=$?
  if [[ $pack_rc -ne 0 || -z "$packed_name" || ! -f "$pack_out/$packed_name" ]]; then
    rm -rf "$tmp_root"
    fail "local package artifact creation failed"
    return 2
  fi

  short_head="${head:0:12}"
  artifact_name="toadaid-agent-capabilities-${package_version}-${short_head}.tgz"
  artifact_target="$ARTIFACT_ROOT/$artifact_name"
  artifact_temp="$tmp_root/$artifact_name"
  mv "$pack_out/$packed_name" "$artifact_temp"
  move_pack_rc=$?
  if [[ $move_pack_rc -ne 0 ]]; then
    rm -rf "$tmp_root"
    fail "cannot stage exact artifact"
    return 2
  fi

  artifact_sha256="$(sha256_file "$artifact_temp")"
  artifact_sha_rc=$?
  if [[ $artifact_sha_rc -ne 0 ]]; then
    rm -rf "$tmp_root"
    fail "cannot hash package artifact"
    return 2
  fi

  write_exact "$artifact_target" 0600 "$artifact_temp"
  artifact_write_rc=$?
  if [[ $artifact_write_rc -ne 0 ]]; then
    rm -rf "$tmp_root"
    return 2
  fi

  manifest_temp="$tmp_root/agent-integration.json"
  node - \
    "$REPO_ROOT" "$branch" "$head" "$tree" \
    "$package_name" "$package_version" "$PROFILE" "$profile_sha256" \
    "$artifact_target" "$artifact_sha256" "$MANIFEST_PATH" >"$manifest_temp" <<'NODE'
const [
  checkoutRoot, branch, head, tree,
  packageName, packageVersion, profile, profileSha256,
  artifactPath, artifactSha256, manifestPath,
] = process.argv.slice(2)

const requestedCapabilities = [
  'browser:evidence',
  'workspace:snapshot',
  'workspace:diff',
  'host:process-read',
]

console.log(JSON.stringify({
  schemaVersion: 'toadaid.agent-capabilities-integration-manifest.v1',
  distribution: 'LOCAL_TARBALL_FROM_EXACT_CHECKOUT',
  checkout: {
    root: checkoutRoot,
    branch,
    head,
    tree,
    cleanAtInstall: true,
  },
  package: {
    name: packageName,
    version: packageVersion,
    private: true,
    artifactPath,
    artifactSha256,
  },
  requestedProfile: {
    profileId: profile,
    profileSha256,
    requestedCapabilities,
  },
  activation: 'OFF',
  capabilityGrants: [],
  providerBindings: {},
  authorityOwner: 'HOST',
  installationGrantsAuthority: false,
  hostPolicyChanged: false,
  hostRuntimeChanged: false,
  hostSecretsChanged: false,
  npmPublicationPerformed: false,
  manifestPath,
}, null, 2))
NODE
  manifest_gen_rc=$?
  if [[ $manifest_gen_rc -ne 0 ]]; then
    rm -rf "$tmp_root"
    fail "cannot generate integration manifest"
    return 2
  fi

  write_exact "$MANIFEST_PATH" 0600 "$manifest_temp"
  manifest_write_rc=$?
  if [[ $manifest_write_rc -ne 0 ]]; then
    rm -rf "$tmp_root"
    return 2
  fi

  rm -rf "$tmp_root"

  node - \
    "$artifact_target" "$artifact_sha256" "$MANIFEST_PATH" "$PROFILE" <<'NODE'
const [artifactPath, artifactSha256, manifestPath, profile] = process.argv.slice(2)
console.log(JSON.stringify({
  schemaVersion: 'toadaid.agent-capabilities-install-result.v1',
  status: 'READY_FOR_HOST_WIRING',
  artifactPath,
  artifactSha256,
  manifestPath,
  requestedProfile: profile,
  activation: 'OFF',
  capabilityGrants: [],
  installationGrantsAuthority: false,
  hostMutationPerformed: false,
  npmPublicationPerformed: false,
}, null, 2))
NODE
  return 0
}

main "$@"
