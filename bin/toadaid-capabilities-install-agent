#!/usr/bin/env bash

# ToadAid Agent Capabilities — generic-agent bootstrap (POSIX entrypoint)
#
# Thin transport wrapper only. ALL installer semantics (arguments, profile
# policy, checkout pinning, artifact rules, manifest, refusals, OFF/BLOCK
# posture) live in the ONE cross-platform Node core next to this file:
#
#   bin/toadaid-capabilities-install-agent.mjs
#
# Linux/macOS/WSL and Windows only invoke that core differently; there is no
# platform-specific installer policy. This wrapper grants no authority.
#
# Shell law:
# - no set -e
# - no set -u
# - no pipefail
# - no explicit shell exit

set +e
set +u
set +o pipefail 2>/dev/null

main() {
  core="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/toadaid-capabilities-install-agent.mjs"

  if ! command -v node >/dev/null 2>&1; then
    printf 'toadaid-capabilities-install-agent: %s\n' "required command unavailable: node" >&2
    return 2
  fi

  node "$core" "$@"
  return $?
}

main "$@"
