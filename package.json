{
  "name": "@toadaid/agent-capabilities",
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./invocation": {
      "types": "./dist/src/surfaces/invocation.d.ts",
      "import": "./dist/src/surfaces/invocation.js"
    },
    "./budget": {
      "types": "./dist/src/runBudgetLedger.d.ts",
      "import": "./dist/src/runBudgetLedger.js"
    },
    "./contracts": {
      "types": "./dist/src/surfaces/contracts.d.ts",
      "import": "./dist/src/surfaces/contracts.js"
    },
    "./replay": {
      "types": "./dist/src/replayFence.d.ts",
      "import": "./dist/src/replayFence.js"
    },
    "./browser-resilience": {
      "types": "./dist/src/browserResilience.d.ts",
      "import": "./dist/src/browserResilience.js"
    },
    "./policy": {
      "types": "./dist/src/surfaces/policy.d.ts",
      "import": "./dist/src/surfaces/policy.js"
    },
    "./modules": {
      "types": "./dist/src/surfaces/modules.d.ts",
      "import": "./dist/src/surfaces/modules.js"
    },
    "./host-session": {
      "types": "./dist/src/surfaces/hostSession.d.ts",
      "import": "./dist/src/surfaces/hostSession.js"
    },
    "./desktop-observation": {
      "types": "./dist/src/surfaces/desktopObservation.d.ts",
      "import": "./dist/src/surfaces/desktopObservation.js"
    },
    "./desktop-interaction": {
      "types": "./dist/src/surfaces/desktopInteraction.d.ts",
      "import": "./dist/src/surfaces/desktopInteraction.js"
    },
    "./host-services": {
      "types": "./dist/src/surfaces/hostServices.d.ts",
      "import": "./dist/src/surfaces/hostServices.js"
    },
    "./browser-runtime": {
      "types": "./dist/src/surfaces/browserRuntime.d.ts",
      "import": "./dist/src/surfaces/browserRuntime.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:build": "tsc -p tsconfig.json",
    "test": "npm run test:build && node --test dist/test/*.test.js",
    "prepare": "npm run build",
    "package:check": "npm run build && node scripts/verify-package.mjs && node scripts/verify-package-surfaces.mjs",
    "prepublishOnly": "npm run package:check",
    "v1:proof": "npm run build && node scripts/v1-agent0-vertical-proof.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "playwright-chromium": "1.63.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "playwright-chromium": "1.63.0"
  },
  "peerDependenciesMeta": {
    "playwright-chromium": {
      "optional": true
    }
  }
}
